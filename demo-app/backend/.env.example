# Rulare prin Docker Compose (recomandat, vezi README): DATABASE_URL/REDIS_URL folosesc
# numele serviciilor din docker-compose.yml ("db"/"redis"), nu "localhost" — dacă rulezi
# backend-ul direct pe host (fără Docker), schimbă-le pe "localhost".
DATABASE_URL=postgresql://ans_demo:ans_demo@db:5432/ans_demo
REDIS_URL=redis://redis:6379
PORT=4000

# Creează un proiect propriu, gratuit, pe https://supabase.com/dashboard — apoi
# Settings → API: Project URL → SUPABASE_URL, "anon public" → SUPABASE_ANON_KEY,
# "service_role" (secret!) → SUPABASE_SERVICE_ROLE_KEY. Service role key are acces
# complet, fără RLS — nu-l pune niciodată în cod/README/commit, doar aici (.env, ignorat de git).
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Opțional — integrare RoEID (autentificare cu buletinul electronic). Fără acordul de
# colaborare oficial cu ADR (github.com/roeid-ro/integrare), lasă-le goale: redirect-ul
# e real, dar autorizarea va fi respinsă (client neînregistrat).
ROEID_CLIENT_ID=
ROEID_CLIENT_SECRET=

# Opțional — necesar doar pentru funcțiile AI ale Chatbot-ului/LMS (generare/rezumat
# text, NL2SQL, sentiment). Cheie gratuită de la https://console.groq.com/keys. Se
# introduce din UI (Securitate → Secrete), nu ca variabilă de mediu — stocată criptat
# în baza de date prin secret manager-ul IAM, nu aici.
# GROQ_API_KEY se configurează din aplicație, nu în acest fișier.
