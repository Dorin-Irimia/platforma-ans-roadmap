{
  "name": "ans-demo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API pentru demo-ul scenariilor obligatorii ANS",
  "main": "src/app.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test:iam": "ts-node src/modules/iam/selftest.ts",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --accept-data-loss",
    "docker:start": "prisma db push --accept-data-loss --skip-generate && npm run dev",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "@supabase/supabase-js": "^2.45.4",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "@prisma/client": "^5.16.1",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "pdf-lib": "^1.17.1",
    "express-rate-limit": "^7.4.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "qrcode": "^1.5.4",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/multer": "^1.4.11",
    "@types/pdfkit": "^0.13.4",
    "@types/ws": "^8.5.12",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.16.1",
    "vitest": "^2.1.8"
  }
}
