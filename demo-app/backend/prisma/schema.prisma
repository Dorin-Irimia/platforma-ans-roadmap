// Schema inițială — se extinde per sprint cu entitățile fiecărui scenariu
// (User/Role/AuditLog pentru IAM, Form/Request/WorkflowStep pentru DMS, etc.)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}
