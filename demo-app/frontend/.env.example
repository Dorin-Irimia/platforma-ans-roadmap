# Dacă rulezi prin Docker Compose și accesezi din același calculator, valoarea de mai
# jos e corectă (browser-ul apelează backend-ul pe portul publicat pe host, nu pe rețeaua
# internă Docker). Schimbă doar dacă accesezi de pe alt dispozitiv din rețea.
VITE_API_URL=http://localhost:4000

# Trebuie să fie EXACT același proiect Supabase ca cel din backend/.env (SUPABASE_URL) —
# vezi acolo instrucțiunile de creare a proiectului. Aici pui doar cheia "anon public"
# (proiectată să fie expusă în client, protejată de RLS) — NU cheia service_role.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
